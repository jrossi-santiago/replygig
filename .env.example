# ── Required for V0 ────────────────────────────────────────────────────────────

# Postgres. On Vercel use the POOLED connection string (Neon -pooler / Supabase
# port 6543) — serverless functions open a connection per invocation.
DATABASE_URL=

# X data. https://api.getxapi.com
GETXAPI_KEY=

# Grok (xAI). https://api.x.ai
XAI_API_KEY=

# Optional, both default to grok-4-1-fast.
XAI_MODEL_FILTER=grok-4-1-fast
XAI_MODEL_DRAFT=grok-4-1-fast

# Any long random string. Vercel Cron sends it as `Authorization: Bearer <this>`.
# Without it /api/cron/crawl returns 401 and never runs.
CRON_SECRET=

# ── V1, not read by any code yet ───────────────────────────────────────────────

APP_URL=http://localhost:3000
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
RESEND_API_KEY=
